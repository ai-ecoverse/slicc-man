{
  "name": "@ai-ecoverse/slicc-man",
  "version": "0.0.0",
  "description": "man, apropos and whatis for SLICC, and scman for SLICC, macOS, Linux and Windows, reading pages from www.sliccy.com/man",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-man.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "scman": "host/scman.mjs"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-man",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "host",
    "lib"
  ],
  "slicc": {
    "unitSources": [
      "host",
      "lib",
      "scripts"
    ]
  },
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint && shellcheck -s sh install.sh && dash -n install.sh",
    "format": "biome check --write .",
    "test": "node --test --test-timeout=120000 test/integration/*.test.mjs",
    "test:unit": "node scripts/cover.mjs",
    "build": "npm pack --dry-run",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "2.11.3",
    "@biomejs/biome": "2.5.15",
    "@semantic-release/exec": "7.1.0",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9"
  }
}
