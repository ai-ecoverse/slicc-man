{
  "name": "@ai-ecoverse/slicc-man",
  "version": "0.0.0",
  "description": "man, apropos and whatis for SLICC, and scman for SLICC, macOS, Linux and Windows, reading pages from www.sliccy.com/man",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-man.git"
  },
  "engines": {
    "node": ">=24",
    "slicc-kernel": ">=1.91.0"
  },
  "bin": {
    "scman": "host/scman.mjs"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-man",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "host",
    "lib"
  ],
  "slicc": {
    "commands": {
      "man": {
        "abi": "js",
        "module": "dist/slicc.mjs",
        "argv0": "man"
      },
      "apropos": {
        "abi": "js",
        "module": "dist/slicc.mjs",
        "argv0": "apropos"
      },
      "whatis": {
        "abi": "js",
        "module": "dist/slicc.mjs",
        "argv0": "whatis"
      },
      "scman": {
        "abi": "js",
        "module": "dist/slicc.mjs",
        "argv0": "scman"
      }
    },
    "unitSources": [
      "host",
      "lib",
      "scripts",
      "slicc"
    ]
  },
  "scripts": {
    "prepare": "slicc-install-hooks",
    "prepack": "node scripts/bundle.mjs",
    "lint": "slicc-lint && shellcheck -s sh install.sh && dash -n install.sh",
    "format": "biome check --write .",
    "test": "node --test --test-timeout=120000 test/integration/*.test.mjs",
    "test:windows": "node --test --test-concurrency=1 --test-timeout=600000 test/integration/host.test.mjs test/integration/windows.test.mjs",
    "test:unit": "node scripts/cover.mjs",
    "build": "npm pack --dry-run",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-kernel": "1.167.4",
    "@ai-ecoverse/slicc-shared-web": "2.13.2",
    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-15",
    "@biomejs/biome": "2.5.15",
    "@semantic-release/exec": "7.1.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9"
  }
}
